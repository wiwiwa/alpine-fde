#!/bin/sh
# alpine-fde-remove.hook — /etc/kernel-hooks.d/ template for kernel removal
# events (docs/Architecture.md §8.3; ADR-19/ADR-13, gap G-C16). `alpine-fde
# install` copies this file into the target root, executable. Replaces the
# retired Debian maintainer-script kernel-removal template via the Alpine ukify-kernel-hook
# convention: the kernel hook runner invokes
#
#   alpine-fde-remove.hook <event> <kver>    event in {add, update, remove}
#
# remove maps to `alpine-fde kernel remove <kver>`: ESP UKI + digest-manifest
# entry dropped together (§8.3 prune, current + 2 retained). add/update
# events are the build hook's business and exit 0 here.
#
# ADR-8: a failing prune is a LOUD failure — the nonzero exit propagates to
# the kernel hook runner and the failure marker is persisted under
# /etc/alpine-fde for `alpine-fde status`. A stale UKI fails closed at boot
# (boots, prompts). Operator recovery: re-run
# `alpine-fde kernel remove <kver>`, or `apk fix` if the package state is
# inconsistent.
#
# Env: ALPINE_FDE_ROOT (target root for the marker, default /);
# ALPINE_FDE_LIB_DIR (runtime; derived from this script's location, falling
# back to /usr/share/alpine-fde/lib). The env namespace is ALPINE_FDE_* only
# (§8.1).

set -u

event=${1:-}
kver=${2:-}
if [ -z "$event" ] || [ -z "$kver" ]; then
    echo "alpine-fde hook: remove: usage: alpine-fde-remove.hook <add|update|remove> <kver> (kernel-hooks.d convention) — refusing to act (ADR-8)" >&2
    exit 64
fi
case $event in
    remove) ;;
    *)
        # add/update events never prune — the build hook owns them
        exit 0
        ;;
esac

ALPINE_FDE_ROOT=${ALPINE_FDE_ROOT:-}
FDE_ETC="$ALPINE_FDE_ROOT/etc/alpine-fde"
marker="$FDE_ETC/build-failed"

# §8.1 machine/lib entrance: resolve the runtime lib dir the same way the
# build hook does, source the lib/cmd remove module DIRECTLY (never exec the
# `alpine-fde` CLI) and run its entry point in a SUBSHELL — the cmd entry
# `exit`s internally; the subshell contains that and propagates the rc.
ALPINE_FDE_LIB_DIR=${ALPINE_FDE_LIB_DIR:-}
if [ -z "$ALPINE_FDE_LIB_DIR" ]; then
    _hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    if [ -f "$_hook_dir/../../lib/manifest.sh" ]; then
        ALPINE_FDE_LIB_DIR="$_hook_dir/../../lib"
    else
        ALPINE_FDE_LIB_DIR=/usr/share/alpine-fde/lib
    fi
fi
if [ ! -f "$ALPINE_FDE_LIB_DIR/common.sh" ] || [ ! -f "$ALPINE_FDE_LIB_DIR/cmd/kernel-remove.sh" ]; then
    echo "alpine-fde hook: remove: alpine-fde runtime not found at $ALPINE_FDE_LIB_DIR (common.sh / cmd/kernel-remove.sh) — cannot prune (ADR-8)" >&2
    exit 64
fi
ALPINE_FDE_CMD_DIR="$ALPINE_FDE_LIB_DIR/cmd"
# shellcheck disable=SC1090  # resolved via the runtime lib dir
. "$ALPINE_FDE_CMD_DIR/kernel-remove.sh"
( cmd_kernel_remove_main "$kver" )
rc=$?
if [ "$rc" -ne 0 ]; then
    mkdir -p "$FDE_ETC" 2>/dev/null || :
    {
        printf 'kernel remove hook: kernel remove failed for kernel %s\n' "$kver"
        printf 'time: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'recovery: re-run "alpine-fde kernel remove %s" (stale UKIs fail closed at boot); "apk fix" if the package state is inconsistent\n' "$kver"
    } >"$marker" 2>/dev/null || :
    exit "$rc"
fi

# success — clear any stale marker from a previous failed attempt
rm -f "$marker" 2>/dev/null || :
exit 0
