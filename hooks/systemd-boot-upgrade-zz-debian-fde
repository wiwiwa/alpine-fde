#!/bin/sh
# systemd-boot-upgrade-zz-debian-fde — template for
# /etc/kernel/postinst.d/zz-debian-fde-systemd-boot-upgrade (§8.3; runs after
# zz-debian-fde in run-parts order). `install` copies this file into the
# target root, executable (enabled).
#
# Guard for the masked systemd-boot-update.service: the boot manager never
# self-updates at boot; when the systemd-boot PACKAGE upgrade re-runs
# `bootctl install` and re-flashes ESP:/EFI/systemd/systemd-bootx64.efi and
# /EFI/BOOT/BOOTX64.EFI, this hook re-signs them with the release key
# (DEBIAN_FDE_KEYDIR). Installation of the signed result is GATED on sbverify
# passing against release.crt — an unverified binary never lands on the ESP.
#
# ADR-18 custody: release.pem may be the ENCRYPTED on-target form. This hook
# unlocks it ONCE via keys_unlock (DEBIAN_FDE_KEY_PASSPHRASE env seam, or the
# no-echo TTY prompt) and signs with the UNLOCKED tmpfs path; the decrypted
# copy is zeroized+removed when the hook exits. A plaintext release.pem
# (offline medium) keeps the previous behavior with no passphrase interaction.
#
# ADR-8: a missing key, missing passphrase, wrong passphrase, or failed
# verification is a LOUD failure — rc 64 + the build-failed marker persisted
# for `debian-fde status`; the previously installed binary stays untouched on
# the verification path. Operator recovery: re-run this hook (enter the
# release-key passphrase when prompted); unattended: provide
# DEBIAN_FDE_KEY_PASSPHRASE via your credential agent, then
# `dpkg --configure -a`.
#
# Env: DEBIAN_FDE_ESP (ESP mount, default /efi), DEBIAN_FDE_KEYDIR (key
# directory), DEBIAN_FDE_ROOT (target root for the marker, default /),
# DEBIAN_FDE_KEY_PASSPHRASE (credential-agent seam, ADR-18),
# DEBIAN_FDE_LIB_DIR (debian-fde runtime; derived from this script's location,
# falling back to /usr/share/debian-fde/lib).

set -u

ESP=${DEBIAN_FDE_ESP:-/efi}
KEYDIR=${DEBIAN_FDE_KEYDIR:-}
DEBIAN_FDE_ETC=${DEBIAN_FDE_ROOT:-}/etc/debian-fde
marker="$DEBIAN_FDE_ETC/build-failed"

guard_fail() {
    mkdir -p "$DEBIAN_FDE_ETC" 2>/dev/null || true
    {
        printf 'boot-manager re-sign failed: %s\n' "$1"
        printf 'time: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'recovery: re-run this hook (enter the release-key passphrase when prompted); unattended: provide DEBIAN_FDE_KEY_PASSPHRASE via your credential agent, then "dpkg --configure -a"\n'
    } >"$marker" 2>/dev/null || true
    exit 64
}

# --- debian-fde runtime (keys.sh: keys_is_encrypted/keys_unlock/keys_scrub) ---
DEBIAN_FDE_LIB_DIR=${DEBIAN_FDE_LIB_DIR:-}
if [ -z "$DEBIAN_FDE_LIB_DIR" ]; then
    _hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    if [ -f "$_hook_dir/../lib/keys.sh" ]; then
        DEBIAN_FDE_LIB_DIR="$_hook_dir/../lib"
    else
        DEBIAN_FDE_LIB_DIR=/usr/share/debian-fde/lib
    fi
fi
if [ ! -f "$DEBIAN_FDE_LIB_DIR/common.sh" ] || [ ! -f "$DEBIAN_FDE_LIB_DIR/keys.sh" ]; then
    guard_fail "debian-fde runtime not found at $DEBIAN_FDE_LIB_DIR (common.sh/keys.sh) — cannot unlock the release key (ADR-18)"
fi
# shellcheck source=../lib/common.sh
. "$DEBIAN_FDE_LIB_DIR/common.sh"
# shellcheck source=../lib/keys.sh
. "$DEBIAN_FDE_LIB_DIR/keys.sh"

[ -n "$KEYDIR" ] || guard_fail "no key directory configured (DEBIAN_FDE_KEYDIR unset)"
for f in release.pem release.crt; do
    [ -f "$KEYDIR/$f" ] || guard_fail "missing key material: $KEYDIR/$f"
done

# ADR-18: unlock the release key ONCE (no-op for a plaintext release.pem)
_hook_keyfile="$KEYDIR/release.pem"
_hook_unlocked=''
_hook_unlock_rc=0
if keys_is_encrypted "$_hook_keyfile"; then
    _hook_unlocked=$(keys_unlock "$KEYDIR") || _hook_unlock_rc=$?
    if [ "$_hook_unlock_rc" -ne 0 ]; then
        if [ -n "${DEBIAN_FDE_KEY_PASSPHRASE:-}" ]; then
            guard_fail "release.pem unlock failed: wrong passphrase (DEBIAN_FDE_KEY_PASSPHRASE rejected) — release key stays locked (ADR-18)"
        fi
        guard_fail "release.pem is encrypted: passphrase required; provide DEBIAN_FDE_KEY_PASSPHRASE or run interactively (ADR-18)"
    fi
    chmod 600 "$_hook_unlocked" 2>/dev/null || :
    _hook_keyfile=$_hook_unlocked
    # zeroize+remove the decrypted copy on EVERY exit path (guard_fail's exit
    # included); keys_scrub is best effort and never masks the hook's rc
    trap 'keys_scrub "${_hook_unlocked:-}" 2>/dev/null || true' EXIT
fi

for rel in EFI/systemd/systemd-bootx64.efi EFI/BOOT/BOOTX64.EFI; do
    src="$ESP/$rel"
    [ -f "$src" ] || guard_fail "boot-manager binary missing on ESP: $src"
    # verify-first (review LO-05): sbsign APPENDS signatures — re-signing an
    # already-signed binary stacks a dual signature, which a later revocation
    # of the old key renders outright rejected (the §9.6/s16 failure mode).
    # A manual hook re-run (the documented ADR-8 recovery) on a binary that
    # already verifies against the CURRENT key is an idempotent no-op.
    if sbverify --cert "$KEYDIR/release.crt" "$src" >/dev/null 2>&1; then
        printf 'debian-fde hook: %s already verifies against the current key — skip re-sign\n' "$src" >&2
        continue
    fi
    tmp="$src.signed.$$"
    if ! sbsign --key "$_hook_keyfile" --cert "$KEYDIR/release.crt" --output "$tmp" "$src"; then
        rm -f "$tmp" 2>/dev/null || true
        guard_fail "sbsign failed for $src"
    fi
    # gate: the signed output must verify against the release cert BEFORE it
    # replaces anything — no unverified binary ever lands on the ESP
    if ! sbverify --cert "$KEYDIR/release.crt" "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true
        guard_fail "sbverify failed for $src — not installed"
    fi
    if ! mv -f "$tmp" "$src"; then
        rm -f "$tmp" 2>/dev/null || true
        guard_fail "install failed for $src"
    fi
done

# success — clear any stale marker from a previous failed attempt
rm -f "$marker" 2>/dev/null || true
exit 0
