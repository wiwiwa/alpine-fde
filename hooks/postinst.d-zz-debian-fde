#!/bin/sh
# postinst.d-zz-debian-fde — template for /etc/kernel/postinst.d/zz-debian-fde
# (docs/Architecture.md §8.3, gap B-G6). `install` copies this file into the
# target root, executable. Consume dracut's initrd: dracut's own postinst hook
# sorts before "zz-", so the initramfs for the new kernel already exists when
# this runs (all ESP writes go through Debian FDE's signed flow; dracut's own
# ESP-sync is disabled, §8.3).
#
# dpkg contract: kernel postinst.d hooks are run via run-parts with
#   $1 = the new kernel's ABI version (e.g. 6.12.8-1-amd64)
#   DEB_MAINT_PARAMS = "$@" of the maintainer script, e.g. "configure 6.12.8-1"
# We act on configure passes (and manual invocations without the env var).
#
# ADR-8: a failing build must fail loudly — non-zero exit propagates to dpkg,
# the failure marker is persisted for `debian-fde status`, and the PREVIOUS
# default UKI is never touched (ukictl build writes the ESP atomically and
# prunes only after success). Operator recovery (ADR-18): re-run
# `debian-fde ukictl build <kver>` and enter the release-key passphrase when
# prompted; unattended, provide DEBIAN_FDE_KEY_PASSPHRASE via your credential
# agent, then `dpkg --configure -a`.

set -u

kver=${1:-}
if [ -z "$kver" ]; then
    echo "debian-fde hook: postinst: no kernel version argument (\$1=<kver>, dpkg hook convention) — refusing to act (ADR-8)" >&2
    exit 64
fi

# DEB_MAINT_PARAMS awareness: only act on configure passes (dracut-hook style)
if [ -n "${DEB_MAINT_PARAMS:-}" ]; then
    case $DEB_MAINT_PARAMS in
        *configure*) ;;
        *)
            exit 0
            ;;
    esac
fi

DEBIAN_FDE_BIN=${DEBIAN_FDE_BIN:-debian-fde}
DEBIAN_FDE_ETC=${DEBIAN_FDE_ROOT:-}/etc/debian-fde
marker="$DEBIAN_FDE_ETC/build-failed"

"$DEBIAN_FDE_BIN" ukictl build "$kver"
rc=$?
if [ "$rc" -ne 0 ]; then
    mkdir -p "$DEBIAN_FDE_ETC" 2>/dev/null || true
    # APPEND, don't overwrite (review IN-04): the build already wrote a marker
    # naming the exact failing step/pin — keep it and add the recovery line
    # beneath it.
    {
        printf 'kernel hook: ukictl build failed for kernel %s\n' "$kver"
        printf 'time: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'recovery: re-run "debian-fde ukictl build %s" (enter the release-key passphrase when prompted); unattended: provide DEBIAN_FDE_KEY_PASSPHRASE via your credential agent, then "dpkg --configure -a"\n' "$kver"
    } >>"$marker" 2>/dev/null || true
    exit "$rc"
fi

# success — clear any stale marker from a previous failed attempt
rm -f "$marker"
exit 0
